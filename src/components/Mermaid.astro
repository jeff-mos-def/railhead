---
// Renders <pre class="mermaid"> blocks in the browser. The build only emits the
// diagram source (rehype-mermaid "pre-mermaid" strategy), so no headless browser
// is needed at build time. Mermaid loads only on pages that contain a diagram.
---

<style is:global>
  pre.mermaid {
    border: 0;
    background: transparent;
    text-align: center;
    white-space: pre;
  }

  pre.mermaid:not([data-rendered]) {
    color: transparent;
  }

  pre.mermaid img.mermaid-diagram {
    display: inline-block;
    max-width: 100%;
    height: auto;
    margin: 0;
  }
</style>

<script>
  let observer: MutationObserver | undefined;

  // Diagrams go into the page as <img> elements, the same way the old
  // build-time rendering delivered them, so the lightbox can open them.
  function svgToImage(svgMarkup: string): HTMLImageElement {
    const holder = document.createElement("div");
    holder.innerHTML = svgMarkup;
    const svg = holder.querySelector("svg");
    const img = document.createElement("img");
    img.alt = "Diagram";
    img.className = "mermaid-diagram";
    if (!svg) return img;

    // Give the image a real size from the viewBox instead of Mermaid's 100% width
    const viewBox = svg.getAttribute("viewBox")?.split(/[\s,]+/).map(Number);
    if (viewBox && viewBox.length === 4) {
      svg.setAttribute("width", String(viewBox[2]));
      svg.setAttribute("height", String(viewBox[3]));
    }
    svg.removeAttribute("style");

    const xml = new XMLSerializer().serializeToString(svg);
    img.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(xml);
    return img;
  }

  async function renderMermaid() {
    const blocks = Array.from(document.querySelectorAll<HTMLElement>("pre.mermaid"));
    if (blocks.length === 0) return;

    const { default: mermaid } = await import("mermaid");
    const dark = document.documentElement.classList.contains("dark");
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: dark ? "dark" : "default",
    });

    for (const [i, block] of blocks.entries()) {
      // Keep the original source so diagrams can be redrawn after a theme change
      if (!block.dataset.source) block.dataset.source = block.textContent ?? "";
      const { svg } = await mermaid.render(`mermaid-${Date.now()}-${i}`, block.dataset.source);
      block.replaceChildren(svgToImage(svg));
      block.dataset.rendered = "true";
    }

    // Tell the lightbox to pick up the new diagram images
    document.dispatchEvent(new CustomEvent("mermaid:rendered"));

    // Redraw when the site theme switches between light and dark
    observer?.disconnect();
    let lastDark = dark;
    observer = new MutationObserver(() => {
      const nowDark = document.documentElement.classList.contains("dark");
      if (nowDark !== lastDark) {
        lastDark = nowDark;
        renderMermaid();
      }
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  }

  // Fires on the first load and after every client-side navigation
  document.addEventListener("astro:page-load", renderMermaid);
</script>
